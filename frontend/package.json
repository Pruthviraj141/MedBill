{
  "name": "cafe-pos-mobile",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:web": "vite --host 0.0.0.0",
    "dev:print-agent": "cd ../usb-print-agent && PRINTER_MODE=virtual npm start",
    "dev": "concurrently -n \"VITE,PRINT-PROXY\" -c \"magenta,blue\" \"npm run dev:web\" \"npm run dev:print-agent\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test:sqlite": "node scripts/run-sqlite-tests.mjs",
    "test:sync": "node scripts/run-sync-tests.mjs",
    "test:printer": "tsx scripts/test-printer.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@capacitor-community/sqlite": "latest",
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "latest",
    "@capacitor/core": "latest",
    "@capacitor/preferences": "latest",
    "@fontsource-variable/inter": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "framer-motion": "^13.2.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-hook-form": "^7.87.0",
    "react-qr-code": "^2.2.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "latest",
    "better-sqlite3": "^13.0.3",
    "concurrently": "^10.0.5",
    "sql.js": "^1.14.2",
    "tsx": "^4.23.13",
    "typescript": "latest",
    "vite": "latest"
  }
}
